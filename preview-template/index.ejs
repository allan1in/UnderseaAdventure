<html>
    <head>
        <link rel="icon" href="./favicon.ico" />
        <meta charset="utf-8" />
        <title><%=title%></title>
        <meta
            name="viewport"
            content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"
        />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="full-screen" content="yes" />
        <meta name="screen-orientation" content="portrait" />
        <meta name="x5-fullscreen" content="true" />
        <meta name="360-fullscreen" content="true" />
        <meta name="renderer" content="webkit" />
        <meta name="force-rendering" content="webkit" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

        <link rel="stylesheet" type="text/css" href="./index.css" />
    <link rel="stylesheet" href="./loading/loading.css">
</head>
    <body style="overflow: hidden;">
        <%- include(cocosToolBar, {config: config}) %>
        <div id="content" class="content" style="overflow: hidden;">
            <div class="contentWrap">
                <div id="GameDiv" class="wrapper">
                    <div id="Cocos3dGameContainer">
                        <canvas id="GameCanvas" tabindex="-1" style="background-color: '';"></canvas>
                    </div>
                    <div id="splash" class="undersea-loading" role="status" aria-label="正在加载海底冒险">
  <div class="ocean-rays" aria-hidden="true"></div>
  <div class="ocean-bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <main class="loading-content">
    <img class="loading-logo" src="./loading/logo.png" alt="UNDERSEA HEROES" fetchpriority="high">
    <div class="loading-party" aria-hidden="true">
      <img class="companion seahorse" src="./loading/seahorse.png" alt="">
      <img class="companion turtle" src="./loading/turtle.png" alt="">
      <div class="hero-glow"></div><img class="loading-hero" src="./loading/hero.png" alt="">
      <img class="companion jellyfish" src="./loading/jellyfish.png" alt="">
      <img class="companion shark" src="./loading/shark.png" alt="">
    </div>
    <div class="loading-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="游戏加载进度">
      <div class="progress-bar"><span style="width:0%"></span></div>
    </div>
    <p class="loading-status"><span id="loading-message">正在准备海底世界…</span><span id="loading-percent"></span></p>
  </main>
  <div class="ocean-floor" aria-hidden="true"></div>
</div>

                    <div id="bulletin">
                        <div id="sceneIsEmpty" class="inner"><%=tip_sceneIsEmpty%></div>
                    </div>
                    <div class="error" id="error">
                        <div class="title">Error <i>(Please open the console to see detailed errors)</i></div>
                        <div class="error-main"></div>
                        <div class="error-stack"></div>
                    </div>
                </div>
            </div>
        </div>
        <%- include(cocosTemplate, {}) %>
    <script src="./loading/loading.js"></script>
</body>
</html>
